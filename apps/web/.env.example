# ─── API ──────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ─── Environment ──────────────────────────────────────────────────────────────
# "development" | "staging" | "production"
VITE_ENV=development

# ─── Cloudflare Turnstile ──────────────────────────────────────────────────────
# Local dev: always-pass test key — https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Production: replace with your real site key from dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ───────────── DATABASE ─────────────
DB_NAME=quizblitz
DB_USER=quizblitz_user
DB_PASSWORD=

# ───────────── PGADMIN ─────────────
PGADMIN_DEFAULT_EMAIL=admin@quizblitz.local
PGADMIN_DEFAULT_PASSWORD=

# ───────────── JWT ─────────────
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Flatten:  awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ───────────── RESEND EMAIL ─────────────
# Create an API key at: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# ───────────── GOOGLE OAUTH ─────────────
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ───────────── API ─────────────
NODE_ENV=development
PORT=3000
DB_HOST=postgres
DB_PORT=5432
FRONTEND_URL=http://localhost:5173

# ───────────── CLOUDFLARE R2 ─────────────
# Create bucket + API token at: dash.cloudflare.com → R2
# Enable public access on the bucket to get R2_PUBLIC_URL
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=quizblitz-dev
R2_PUBLIC_URL=https://<account-hash>.r2.dev

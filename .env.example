# ───────────── DATABASE ─────────────
DB_NAME=quizblitz
DB_USER=quizblitz_user
DB_PASSWORD=

# ───────────── PGADMIN ─────────────
PGADMIN_DEFAULT_EMAIL=admin@quizblitz.local
PGADMIN_DEFAULT_PASSWORD=

# ───────────── JWT ─────────────
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Flatten:  awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ───────────── API ─────────────
NODE_ENV=development
PORT=3000
DB_HOST=postgres
DB_PORT=5432
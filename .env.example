# ───────────── DATABASE ─────────────
# Primary connection string — used by the API at runtime.
# Local dev (Docker):     postgresql://quizblitz_user:<password>@postgres:5432/quizblitz
# Supabase (production):  get this from: Supabase dashboard → Project Settings → Database → Connection string → URI
# IMPORTANT: Always use port 5432 (Session mode). Port 6543 is Transaction mode — TypeORM prepared statements fail silently.
# Add ?sslmode=require for Supabase/managed Postgres; the app enables SSL automatically when it detects this flag.
DATABASE_URL=
DB_NAME=quizblitz
DB_USER=quizblitz_user
DB_PASSWORD=

# ───────────── PGADMIN ─────────────
PGADMIN_DEFAULT_EMAIL=admin@quizblitz.dev
PGADMIN_DEFAULT_PASSWORD=

# ───────────── JWT ─────────────
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Flatten:  awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ───────────── GOOGLE OAUTH ─────────────
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ───────────── API ─────────────
NODE_ENV=development
PORT=3000
DB_HOST=postgres
DB_PORT=5432
FRONTEND_URL=http://localhost:5173

# ───────────── CLOUDFLARE R2 (production) ─────────────
# Create bucket + API token at: dash.cloudflare.com → R2
# Enable public access on the bucket to get R2_PUBLIC_URL
# Leave R2_ENDPOINT unset for production — it defaults to the R2 endpoint
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quizblitz-dev
R2_PUBLIC_URL=
# R2_ENDPOINT=

# ───────────── MinIO (local dev — replaces R2) ─────────────
# Console UI: http://localhost:9001  |  S3 API: http://localhost:9000
# Uncomment this block and comment out the R2 block above when running locally
# R2_ACCOUNT_ID=local
# R2_ACCESS_KEY_ID=minioadmin
# R2_SECRET_ACCESS_KEY=minioadmin
# R2_BUCKET_NAME=quizblitz-dev
# R2_PUBLIC_URL=http://localhost:9000/quizblitz-dev
# R2_ENDPOINT=http://minio:9000

# ───────────── TURNSTILE ─────────────
# Create a site at: dash.cloudflare.com → Turnstile → Add site (Invisible widget type)
# Local dev test keys (always pass): site key 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Mobile/web public key — safe to commit; use test key 1x00000000000000000000AA locally
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# ───────────── EMAIL (production) ─────────────
# Create an API key at: resend.com → API Keys
RESEND_API_KEY=
FROM_EMAIL=

# ───────────── Mailpit (local dev — replaces Resend) ─────────────
# Web inbox: http://localhost:8025  |  SMTP: localhost:1025
# Uncomment when running locally — RESEND_API_KEY is not required when SMTP_HOST is set
# SMTP_HOST=mailpit
# SMTP_PORT=1025
